<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon background. A gradient drawable rather than a bitmap, so it
     stays crisp at every density and under every launcher mask. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#3A6EA5"
        android:endColor="#11263E" />
</shape>
